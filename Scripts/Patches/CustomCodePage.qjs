*   Copyright (C) 2026 Louis T Steinhil                                    *
*                                                                          *
*   This file is a part of WARP project (specific to RO clients)           *
*                                                                          *
*   Description   : Overrides the 2026-02-19 client's multibyte code page.  *
*                   This is the 0219 equivalent of the WARP0716            *
*                   CustomCodePage patch: it patches _setmbcp, the          *
*                   langtype mapper and every global code-page assignment.  *
*                                                                          *
\**************************************************************************/

CustomCodePage = function(_)
{
	const codePage = CustomCodePage.getCodePage();
	if (codePage < 0)
		return true;

	CustomCodePage.patchSetMbcp(_, codePage);
	CustomCodePage.patchLangtypeCodePageMapper(_, codePage);
	CustomCodePage.patchGlobalCodePageAssignments(_, codePage);

	return true;
};

CustomCodePage.getCodePage = function()
{
	const codePage = Exe.GetUserInput(
		'$customCodePage',
		D_Int32,
		"Client Code Page",
		"Enter the codepage to force for client multibyte text conversion. Use 936 for Simplified Chinese.",
		936,
		{min: -1, max: 65001, saveDefault: true}
	);
	if (codePage === false)
		Cancel("Codepage override disabled");

	return Number(codePage);
};

CustomCodePage.patchSetMbcp = function(_, codePage)
{
	$$(_, 1.1, `Patch _setmbcp call`);
	const patched = Exe.FindHex("68 B5 03 00 00 FF 15");
	if (patched < 0)
		throw Error("CustomCodePage: _setmbcp(949) call not found");

	Exe.SetUint32(patched + 1, codePage);
};

CustomCodePage.patchLangtypeCodePageMapper = function(_, codePage)
{
	$$(_, 2.1, `Patch langtype code-page mapper`);
	const mapper = Exe.FindHex("55 8B EC 8B 45 08 83 C0 80 83 F8 6E");
	if (mapper < 0)
		throw Error("CustomCodePage: langtype mapper prologue not found");

	Exe.SetHex(mapper, " B8" + codePage.toHex(4) + " C3");
};

CustomCodePage.patchGlobalCodePageAssignments = function(_, codePage)
{
	$$(_, 3.1, `Patch global code-page assignments`);
	const addrs = Exe.FindHexN("C7 05 78 3A 6D 01");
	if (!addrs || addrs.length === 0)
		throw Error("CustomCodePage: global code-page assignments not found");

	for (const addr of addrs)
		Exe.SetUint32(addr + 6, codePage);
};
